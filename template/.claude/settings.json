{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/harness/record-activity.mjs"],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/harness/loop-breaker.mjs"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/harness/record-activity.mjs"],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": [".claude/harness/loop-breaker.mjs"],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/harness/record-activity.mjs"],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": [".claude/harness/verify-gate.mjs"],
            "statusMessage": "Verifying subagent work",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/harness/claim-check.mjs"],
            "statusMessage": "Checking claims against what ran",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node",
            "args": [".claude/harness/verify-gate.mjs"],
            "statusMessage": "Verifying before finishing",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
